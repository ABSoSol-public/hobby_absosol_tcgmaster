# === Datenbank (MariaDB auf der Synology) ===
DB_HOST=192.168.1.10        # IP der Synology / des MariaDB-Hosts
DB_PORT=3307                # Synology-MariaDB-Standardport (oft 3306 oder 3307)
DB_USER=tcg
DB_PASSWORD=BITTE_AENDERN
DB_NAME=tcg_collection

# === Backend ===
API_PORT=3001
# Optional: API-Key für pokemontcg.io (kostenlos unter https://dev.pokemontcg.io);
# ohne Key läuft der Pokémon-Import mit strengem Rate-Limit deutlich langsamer.
POKEMON_TCG_API_KEY=
# Erlaubte Origins für CORS (Komma-getrennt); im Docker-Setup nicht nötig,
# da nginx /api als Proxy bereitstellt.
CORS_ORIGINS=http://localhost:5173
# Verzeichnis der lokal gespiegelten Kartenbilder (npm run images:download).
# Die API liefert ausschließlich diese lokalen Kopien unter /images/... aus
# (Hotlinking auf die externen Quellen ist nicht erlaubt). Im Docker-Setup wird
# das Verzeichnis read-only in den Backend-Container gemountet.
# Ohne Angabe: <projektroot>/data_images. Auf der Synology z. B.:
# IMAGES_DIR=/volume1/docker/tcg/images
IMAGES_DIR=
# Der Backend-Container läuft standardmäßig als unprivilegierter User (UID/GID
# 1000). Gehört IMAGES_DIR einem anderen Nutzer (z. B. eigene Synology-Freigabe
# mit eigenen ACLs), hier dessen UID/GID eintragen — sonst "EACCES: permission
# denied" beim Ausliefern der Bilder. Achtung: Synology-ACLs überschreiben die
# sichtbaren Unix-Rechte und gewähren oft NICHT dem angezeigten Besitzer
# Zugriff, sondern nur explizit gelisteten Nutzern/Gruppen — mit
# `synoacltool -get <pfad>` prüfen, wer wirklich "allow" hat, und dessen
# UID/GID per `id <benutzer>` eintragen (siehe docs/DEPLOYMENT-SYNOLOGY.md).
BACKEND_UID=1000
BACKEND_GID=1000
# Signiert die Login-Session (JWT im httpOnly-Cookie). Pflichtfeld — das Backend
# startet ohne diesen Wert nicht. Erzeugen mit z. B. `openssl rand -hex 32`.
# Login-Accounts selbst legt man mit `npm run user:create -- <username> <passwort>` an.
JWT_SECRET=
# Login-Cookie als "Secure" markieren (nur über HTTPS gesendet). Default aus,
# da der übliche LAN-Betrieb (Abschnitt DEPLOYMENT-SYNOLOGY.md) ohne TLS läuft —
# ein Secure-Cookie würde der Browser dort sofort verwerfen (Login wirkt kurz
# erfolgreich, fällt aber gleich zurück auf die Anmeldemaske). Auf 'true'
# setzen, sobald ein TLS-Reverse-Proxy vorgeschaltet ist (siehe
# docs/DEPLOYMENT-SYNOLOGY.md Abschnitt 10, Let's Encrypt + DSM Reverse Proxy).
COOKIE_SECURE=

# === Frontend (nur Docker-Build) ===
FRONTEND_PORT=8080
# Erzwingt HTTPS (Redirect), sobald ein TLS-Reverse-Proxy vorgeschaltet ist —
# schließt den sonst parallel weiterhin offenen, unverschlüsselten Direktzugriff
# auf FRONTEND_PORT. Default aus (reiner LAN-HTTP-Betrieb funktioniert ohne dies
# weiterhin normal). Zusammen mit COOKIE_SECURE=true setzen, siehe
# docs/DEPLOYMENT-SYNOLOGY.md Abschnitt 10.
FORCE_HTTPS=
